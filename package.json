{
  "name": "@local/opencode-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "opencode console visual language for the DSH Web UI — settings page and main interface.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "src",
    "docs",
    "build.mjs",
    "tools",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "author": "Cenuon",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cenuon/dsh-opencode-ui.git"
  },
  "homepage": "https://github.com/Cenuon/dsh-opencode-ui#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opencode",
    "theme",
    "plugin",
    "cordis",
    "ui"
  ]
}
